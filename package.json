{
  "name": "job-portal-backend",
  "version": "1.0.0",
  "description": "Job Portal REST API with Express, PostgreSQL, and SendGrid",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:schema": "node src/utils/runSchema.js",
    "seed:admin": "node src/utils/seedAdmin.js",
    "verify:user": "node src/utils/verifyUserByEmail.js"
  },
  "keywords": [
    "job-portal",
    "express",
    "postgresql",
    "sendgrid"
  ],
  "license": "MIT",
  "dependencies": {
    "@sendgrid/mail": "^8.1.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
